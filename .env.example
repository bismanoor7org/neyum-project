# Fiji Luxury — Environment Variables
# Copy to .env.local for local development.
# Set all required values in Vercel → Project → Settings → Environment Variables.

# ── Database (Supabase PostgreSQL) ───────────────────────────────────────────
# App runtime — use Supabase connection pooler (port 6543, pgbouncer=true)
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=10
# Migrations / Prisma Studio — use direct connection (port 5432)
DIRECT_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# Local Prisma Dev (alternative — comment out Supabase URLs above)
# DATABASE_URL=postgresql://postgres:postgres@localhost:51214/template1?sslmode=disable
# DIRECT_URL=postgresql://postgres:postgres@localhost:51214/template1?sslmode=disable

# ── App URLs ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Session signing (required, min 32 characters) ───────────────────────────
ADMIN_SESSION_SECRET=your-random-32-plus-character-secret-here
# Optional dedicated secrets (default: ADMIN_SESSION_SECRET)
# TRAVELLER_SESSION_SECRET=
# SUPPLIER_SESSION_SECRET=

# ── Clerk authentication ─────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

# ── Supabase Auth (Google OAuth via signInWithOAuth) ─────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT_REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional — server-only admin operations (CMS service role / invites / storage)
SUPABASE_SERVICE_ROLE_KEY=

# ── Google OAuth (configure Client ID + Secret in Supabase → Auth → Providers) ─
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ── Stripe payments ──────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Cloudinary (CMS media library) ───────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=Fiji Luxury <onboarding@resend.dev>

# ── Google Maps (explore map) ────────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# ── Visa AI assistant (at least one provider) ────────────────────────────────
VISA_AI_PROVIDER=auto
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# OPENAI_CMS_MODEL=gpt-4o-mini
# GEMINI_CMS_MODEL=gemini-1.5-flash
# OPENAI_MODEL=gpt-4o-mini
# GEMINI_MODEL=gemini-2.0-flash
# CLAUDE_MODEL=claude-3-5-haiku-latest

# ── Public concierge / analytics (optional) ──────────────────────────────────
# NEXT_PUBLIC_WHATSAPP_NUMBER=6799999999
# NEXT_PUBLIC_CONCIERGE_PHONE=+679 000 0000
# NEXT_PUBLIC_CONCIERGE_EMAIL=concierge@fijiluxuryexperiences.com
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXX
# NEXT_PUBLIC_CLARITY_ID=
# GA4_PROPERTY_ID=properties/123456789
# GA4_SERVICE_ACCOUNT_JSON=

# ── Optional integrations ────────────────────────────────────────────────────
ENQUIRY_WEBHOOK_URL=

# ── Admin bootstrap (scripts/create-admin.ts only) ───────────────────────────
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=
