}

model PaymentAttempt {
  id              String               @id @default(cuid())
  bookingId       String?
  checkoutSessionId String?
  paymentId       String?
  stripeIntentId  String?              @unique
  idempotencyKey  String               @unique
  amount          Decimal              @db.Decimal(12, 2)
  currency        String               @default("FJD")
  status          PaymentAttemptStatus @default(PENDING)
  paymentMethod   String?
  failureMessage  String?
  metadata        Json?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  booking         Booking?         @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  checkoutSession CheckoutSession? @relation(fields: [checkoutSessionId], references: [id], onDelete: SetNull)
  payment         Payment?         @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([checkoutSessionId])
  @@index([status])
  @@map("payment_attempts")
}

model Transaction {
  id            String          @id @default(cuid())
  bookingId     String
  type          TransactionType
  amount        Decimal         @db.Decimal(12, 2)
  currency      String          @default("FJD")
  stripeChargeId String?
  reference     String?
  metadata      Json?
  createdAt     DateTime        @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  @@index([bookingId, type])
  @@map("transactions")
}

model BookingInvoice {
  id            String   @id @default(cuid())
  bookingId     String   @unique
  invoiceNumber String   @unique
  subtotal      Decimal  @db.Decimal(12, 2)
  taxAmount     Decimal  @db.Decimal(12, 2)
  serviceFee    Decimal  @db.Decimal(12, 2)
  discountAmount Decimal @db.Decimal(12, 2)
  totalAmount   Decimal  @db.Decimal(12, 2)
  currency      String   @default("FJD")
  pdfUrl        String?
  issuedAt      DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([invoiceNumber])
  @@map("booking_invoices")
}

model BookingVoucher {
  id            String   @id @default(cuid())
  bookingId     String   @unique
  voucherNumber String   @unique
  qrCodeData    String
  pdfUrl        String?
  issuedAt      DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([voucherNumber])
  @@map("booking_vouchers")
}

model PromoCode {
  id            String            @id @default(cuid())
  code          String            @unique
  description   String?
  discountType  PromoDiscountType
  discountValue Decimal           @db.Decimal(12, 2)
  minAmount     Decimal?          @db.Decimal(12, 2)
  maxUses       Int?
  usedCount     Int               @default(0)
  active        Boolean           @default(true)
  expiresAt     DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([active, expiresAt])
  @@map("promo_codes")
}

model Coupon {
  id            String            @id @default(cuid())
  code          String            @unique
  description   String?
  discountType  PromoDiscountType
  discountValue Decimal           @db.Decimal(12, 2)
  minAmount     Decimal?          @db.Decimal(12, 2)
  maxUses       Int?
  usedCount     Int               @default(0)
  active        Boolean           @default(true)
  expiresAt     DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([active, expiresAt])
  @@map("coupons")
}

model BookingLog {
  id        String           @id @default(cuid())
  bookingId String?
  sessionId String?
  action    BookingLogAction
  message   String?
  metadata  Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime         @default(now())

  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([bookingId, createdAt])
  @@index([sessionId])
  @@map("booking_logs")
}

// ─────────────────────────────────────────────────────────────────────────────
// CMS — My Fiji Tour Content Management System
// ─────────────────────────────────────────────────────────────────────────────

enum AdminStaffRole {
  SUPER_ADMIN
  ADMIN
  EDITOR
  CONTENT_MANAGER
  SUPPORT_MANAGER
}

enum CmsEntityType {
  HOMEPAGE
  DESTINATION
  TOUR
  TRANSPORT
  GUIDE
  FAQ
  TESTIMONIAL
  BANNER
  ACCOMMODATION
  DEAL
  NAVIGATION
  PAGE
  POST
}

enum DealCategory {
  PACKAGE
  ACCOMMODATION
  EXPERIENCE
}

enum NavigationLocation {
  PRIMARY
  MEGA_MENU
  FOOTER
}

enum SupplierContentType {
  TOUR
  TRANSPORT
  DESCRIPTION
  IMAGE
  GALLERY
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  REVISION_REQUESTED
}

/// Admin staff role assignment — granular CMS & ops permissions
model AdminStaffProfile {
  id          String         @id @default(cuid())
  userId      String         @unique
  staffRole   AdminStaffRole @default(CONTENT_MANAGER)
  permissions Json?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([staffRole])
  @@map("admin_staff_profiles")
}

/// Polymorphic SEO metadata — one record per CMS entity
model SeoMeta {
  id              String        @id @default(cuid())
  entityType      CmsEntityType
  entityId        String
  metaTitle       String?
  metaDescription String?       @db.Text
  ogTitle         String?
  ogDescription   String?       @db.Text
  ogImage         String?
  canonicalUrl    String?
  schemaMarkup    Json?
  noIndex         Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([entityType, entityId])
  @@index([entityType])
  @@map("seo_meta")
}

/// Cloudinary-backed media library
model MediaAsset {
  id           String   @id @default(cuid())
  cloudinaryId String   @unique
  publicId     String
  url          String
  secureUrl    String
  format       String?
  resourceType String   @default("image")
  width        Int?
  height       Int?
  bytes        Int?
  folder       String   @default("mft")
  altText      String?
  caption      String?
  tags         String[] @default([])
  isFavorite   Boolean  @default(false) @map("is_favorite")
  uploadedById String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  uploadedBy User? @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([folder, createdAt])
  @@index([uploadedById])
  @@index([isFavorite])
  @@map("media_assets")
}

/// Curated traveller testimonials for homepage & landing pages
model Testimonial {
  id          String        @id @default(cuid())
  authorName  String
  authorTitle String?
  authorImage String?
  location    String?
  content     String        @db.Text
  rating      Int           @default(5)
  featured    Boolean       @default(false)
  status      ContentStatus @default(DRAFT)
  sortOrder   Int           @default(0)
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, featured, sortOrder])
  @@map("testimonials")
}

/// Supplier-submitted content awaiting platform approval
model SupplierContentSubmission {
  id           String              @id @default(cuid())
  supplierId   String
  contentType  SupplierContentType
  entityId     String?
  title        String
  payload      Json
  status       ApprovalStatus      @default(PENDING)
  reviewNote   String?             @db.Text
  reviewedById String?
  reviewedAt   DateTime?
  submittedAt  DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  reviewedBy User?    @relation("SubmissionReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([supplierId, status])
  @@index([contentType, status])
  @@index([submittedAt])
  @@map("supplier_content_submissions")
}

// ─────────────────────────────────────────────────────────────────────────────
// VISA INTELLIGENCE — production visa rules, documents & entry guides
// ─────────────────────────────────────────────────────────────────────────────

enum VisaType {
  VISA_FREE
  VISA_ON_ARRIVAL
  EVISA
  VISA_REQUIRED
}

model Country {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  slug      String   @unique
  flag      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  visaRules                  VisaRule[]
  travelDocumentRequirements TravelDocumentRequirement[]

  @@index([name])
  @@index([slug])
  @@map("countries")
}

model VisaRule {
  id                 String   @id @default(cuid())
  nationalityId      String
  destinationCountry String   @default("FJ")
  visaType           VisaType
  stayDuration       String
  processingTime     String
  entryType          String?
  entryConditions    String?  @db.Text
  notes              String?  @db.Text
  recommendations    Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  nationality Country @relation(fields: [nationalityId], references: [id], onDelete: Cascade)

  @@unique([nationalityId, destinationCountry])
  @@index([destinationCountry])
  @@index([visaType])
  @@map("visa_rules")
}

model TravelDocumentRequirement {
  id                     String  @id @default(cuid())
  nationalityId          String  @unique
  passportValidity       String
  returnTicketRequired   Boolean @default(true)
  hotelBookingRequired   Boolean @default(true)
  proofOfFundsRequired   Boolean @default(false)
  insuranceRequired      Boolean @default(false)
  passportPhotosRequired Boolean @default(false)
  bankStatementRequired  Boolean @default(false)
  additionalDocuments    Json?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  nationality Country @relation(fields: [nationalityId], references: [id], onDelete: Cascade)

  @@map("travel_document_requirements")
}

model EntryGuide {
  id                  String   @id @default(cuid())
  destinationCountry  String   @unique @default("FJ")
  arrivalProcess      String   @db.Text
  immigrationProcess  String   @db.Text
  customsInfo         String   @db.Text
  airportInfo         String   @db.Text
  healthRequirements  String   @db.Text
  travelAdvice        String   @db.Text
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("entry_guides")
}

// ─────────────────────────────────────────────────────────────────────────────
// WordPress-like CMS entities (synced with supabase/migrations)
// ─────────────────────────────────────────────────────────────────────────────

model CmsCategory {
  id          String        @id @default(cuid())
  name        String
  slug        String        @unique
  description String?
  parentId    String?       @map("parent_id")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  parent      CmsCategory?  @relation("CmsCategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    CmsCategory[] @relation("CmsCategoryTree")
  posts       CmsPost[]

  @@map("cms_categories")
}

model CmsTag {
  id        String       @id @default(cuid())
  name      String
  slug      String       @unique
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  posts     CmsPostTag[]

  @@map("cms_tags")
}

model CmsPage {
  id            String        @id @default(cuid())
  title         String
  slug          String        @unique
  excerpt       String?       @db.Text
  content       Json          @default("{}")
  contentHtml   String?       @map("content_html") @db.Text
  featuredImage String?       @map("featured_image")
  status        ContentStatus @default(DRAFT)
  publishedAt   DateTime?     @map("published_at")
  scheduledAt   DateTime?     @map("scheduled_at")
  authorId      String?       @map("author_id")
  parentId      String?       @map("parent_id")
  template      String?       @default("default")
  seo           Json          @default("{}")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  parent        CmsPage?      @relation("CmsPageTree", fields: [parentId], references: [id], onDelete: SetNull)
  children      CmsPage[]     @relation("CmsPageTree")

  @@index([status])
  @@map("cms_pages")
}

model CmsPost {
  id              String        @id @default(cuid())
  title           String
  slug            String        @unique
  excerpt         String?       @db.Text
  content         Json          @default("{}")
  contentHtml     String?       @map("content_html") @db.Text
  featuredImage   String?       @map("featured_image")
  categoryId      String?       @map("category_id")
  authorId        String?       @map("author_id")
  status          ContentStatus @default(DRAFT)
  publishedAt     DateTime?     @map("published_at")
  scheduledAt     DateTime?     @map("scheduled_at")
  featured        Boolean       @default(false)
  readingTimeMin  Int           @default(1) @map("reading_time_min")
  seo             Json          @default("{}")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  category        CmsCategory?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tags            CmsPostTag[]

  @@index([status])
  @@index([categoryId])
  @@index([featured])
  @@map("cms_posts")
}

model CmsPostTag {
  postId String  @map("post_id")
  tagId  String  @map("tag_id")
  post   CmsPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    CmsTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@map("cms_post_tags")
}

model CmsRevision {
  id          String   @id @default(cuid())
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id")
  title       String?
  content     Json?
  contentHtml String?  @map("content_html") @db.Text
  authorId    String?  @map("author_id")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId, createdAt(sort: Desc)])
  @@map("cms_revisions")
}

model CmsSiteSetting {
  key       String   @id
  value     Json     @default("{}")
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by")

  @@map("cms_settings")
}

model CmsRedirect {
  id         String   @id @default(cuid())
  fromPath   String   @unique @map("from_path")
  toPath     String   @map("to_path")
  statusCode Int      @default(301) @map("status_code")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("cms_redirects")
}
