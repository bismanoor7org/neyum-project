// My Fiji Tour — Production marketplace schema
// PostgreSQL + Prisma | Clerk (auth) | Stripe (payments) | Cloudinary (media)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────────────────────

enum UserRole {
  TRAVELER
  SUPPLIER
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
  PENDING_VERIFICATION
}

enum AuthTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
  VERIFIED
}

enum TourStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  ARCHIVED
}

enum TransportType {
  AIRPORT_TRANSFER
  BOAT_TRANSFER
  PRIVATE_DRIVER
  ISLAND_TRANSFER
}

enum ServiceStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  REFUNDED
}

enum StripePaymentStatus {
  REQUIRES_PAYMENT_METHOD
  REQUIRES_CONFIRMATION
  REQUIRES_ACTION
  PROCESSING
  SUCCEEDED
  CANCELED
  FAILED
}

enum SettlementStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
  FLAGGED
}

enum NotificationType {
  BOOKING
  SUPPLIER
  TOUR
  PAYMENT
  REFUND
  REVIEW
  SUPPORT
  SYSTEM
}

enum ActivityModule {
  AUTH
  USERS
  SUPPLIERS
  TOURS
  TRANSPORT
  BOOKINGS
  PAYMENTS
  SETTLEMENTS
  REVIEWS
  CONTENT
  SETTINGS
  SUPPORT
  ANALYTICS
}

enum GuideCategory {
  FIRST_TIME
  VISA
  WEATHER
  CULTURE
  TRANSPORT
  DINING
  SAFETY
  ITINERARY
  GENERAL
}

enum ContentStatus {
  DRAFT
  PENDING_REVIEW
  NEEDS_CHANGES
  APPROVED
  PUBLISHED
  SCHEDULED
  ARCHIVED
}

enum TicketType {
  USER
  SUPPLIER
  COMPLAINT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum AnalyticsSource {
  GOOGLE_ANALYTICS
  MICROSOFT_CLARITY
  SEARCH_CONSOLE
  INTERNAL
}

enum KycStatus {
  NOT_STARTED
  IN_REVIEW
  APPROVED
  REJECTED
  RESUBMIT_REQUIRED
}

enum SupplierMemberRole {
  OWNER
  MANAGER
  SALES_AGENT
  OPERATIONS
  FINANCE
  GUIDE_MANAGER
  CUSTOM
}

enum SupplierMemberStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum DocumentType {
  LICENSE
  INSURANCE
  CERTIFICATION
  CONTRACT
  KYC_ID
  COMPLIANCE
  OTHER
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

enum CalendarBlockType {
  BLACKOUT
  HOLIDAY
  MAINTENANCE
  STAFF_UNAVAILABLE
}

enum AutomationTrigger {
  BOOKING_CONFIRMED
  BOOKING_REMINDER
  PAYMENT_REMINDER
  REVIEW_REQUEST
  DOCUMENT_EXPIRY
  PAYOUT_SENT
  CANCELLATION
}

enum MessageChannel {
  CUSTOMER
  ADMIN
  INTERNAL
}

enum ResourceStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

// ─────────────────────────────────────────────────────────────────────────────
// 1. USERS
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id           String     @id @default(cuid())
  clerkId          String?    @unique
  googleId         String?    @unique
  emailVerifiedAt  DateTime?
  firstName        String
  lastName         String
  email            String     @unique
  passwordHash     String?
  twoFactorSecret String?
  twoFactorEnabled Boolean @default(false)
  phone        String?
  avatar       String?
  role         UserRole   @default(TRAVELER)
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  supplier         Supplier?
  bookings         Booking[]        @relation("TravelerBookings")
  reviews          Review[]
  notifications    Notification[]
  activityLogs     ActivityLog[]
  supportTickets   SupportTicket[]  @relation("TicketSubmitter")
  assignedTickets  SupportTicket[]  @relation("TicketAssignee")

  travellerProfile          TravellerProfile?
  wishlistItems             WishlistItem[]
  wishlistCollections       WishlistCollection[]
  favourites                Favourite[]
  itineraries               TravellerItinerary[]
  travelDocuments           TravelDocument[]
  travelCompanions          TravelCompanion[]
  savedSearches             SavedSearch[]
  travellerMessages         TravellerMessage[]              @relation("TravellerMessages")
  paymentMethods            TravellerPaymentMethod[]
  invoices                  TravellerInvoice[]
  refunds                   TravellerRefund[]
  loyaltyAccount            LoyaltyAccount?
  loginSessions             LoginSession[]
  authTokens                AuthToken[]
  travellerWallet           TravellerWallet?
  notificationPreference    TravellerNotificationPreference?
  promoRedemptions          TravellerPromoRedemption[]
  reviewMedia               ReviewMedia[]
  adminStaffProfile         AdminStaffProfile?
  mediaUploads              MediaAsset[]
  reviewedSubmissions       SupplierContentSubmission[] @relation("SubmissionReviewer")

  @@index([role, status])
  @@index([createdAt])
  @@map("users")
}

// ─────────────────────────────────────────────────────────────────────────────
// 2. SUPPLIERS
// ─────────────────────────────────────────────────────────────────────────────

model Supplier {
  id                 String             @id @default(cuid())
  userId             String             @unique
  companyName        String
  description        String?            @db.Text
  logo               String?
  website            String?
  phone              String?
  address            String?
  country            String?
  city               String?
  taxId              String?
  businessLicenseNo  String?
  verificationStatus VerificationStatus @default(PENDING)
  kycStatus          KycStatus          @default(NOT_STARTED)
  onboardingStep     Int                @default(0)
  rejectionReason    String?            @db.Text
  resubmissionNote   String?            @db.Text
  rating             Decimal            @default(0) @db.Decimal(3, 2)
  healthScore        Decimal            @default(0) @db.Decimal(5, 2)
  responseRate       Decimal            @default(0) @db.Decimal(5, 2)
  cancellationRate   Decimal            @default(0) @db.Decimal(5, 2)
  stripeAccountId    String?
  stripeOnboarded    Boolean            @default(false)
  paypalMerchantId   String?
  instantBooking     Boolean            @default(false)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  user                   User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  tours                  Tour[]
  transportationServices TransportationService[]
  bookings               Booking[]
  settlements            Settlement[]
  commissionRules        CommissionRule[]
  supportTickets         SupportTicket[]
  teamMembers            SupplierTeamMember[]
  documents              SupplierDocument[]
  calendarBlocks         SupplierCalendarBlock[]
  tourAvailabilities     TourAvailability[]
  automations            SupplierAutomation[]
  messages               SupplierMessage[]
  guides                 SupplierGuide[]
  vehicles               SupplierVehicle[]
  customerNotes          SupplierCustomerNote[]
  performanceLogs        SupplierPerformanceLog[]
  notificationPreference SupplierNotificationPreference?
  contentSubmissions     SupplierContentSubmission[]

  @@index([verificationStatus])
  @@index([kycStatus])
  @@index([companyName])
  @@map("suppliers")
}

// ─────────────────────────────────────────────────────────────────────────────
// 3. DESTINATIONS
// ─────────────────────────────────────────────────────────────────────────────

model Destination {
  id          String        @id @default(cuid())
  name        String
  slug        String        @unique
  description String?       @db.Text
  excerpt     String?
  tagline     String?
  heroImage   String?
  gallery     String[]
  highlights  Json?
  content     Json?
  latitude    Decimal?      @db.Decimal(10, 7)
  longitude   Decimal?      @db.Decimal(10, 7)
  featured    Boolean       @default(false)
  status      ContentStatus @default(PUBLISHED)
  sortOrder   Int           @default(0)
  updatedById String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  tours Tour[]
  accommodations Accommodation[]
  deals Deal[]
  transportationServices TransportationService[]

  @@index([featured, sortOrder])
  @@index([status])
  @@map("destinations")
}

// ─────────────────────────────────────────────────────────────────────────────
// 4. TOURS
// ─────────────────────────────────────────────────────────────────────────────

model Tour {
  id              String     @id @default(cuid())
  supplierId      String
  destinationId   String
  title           String
  slug            String     @unique
  description     String     @db.Text
  duration        String
  durationMinutes Int?
  price           Decimal    @db.Decimal(12, 2)
  currency        String     @default("FJD")
  featuredImage   String?
  gallery         String[]
  status          TourStatus @default(DRAFT)
  rating          Decimal    @default(0) @db.Decimal(3, 2)
  reviewCount     Int        @default(0)
  featured        Boolean    @default(false)
  maxGuests       Int        @default(10)
  content         Json?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  supplier    Supplier    @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  destination Destination @relation(fields: [destinationId], references: [id], onDelete: Restrict)
  bookings    Booking[]
  reviews     Review[]
  availabilities TourAvailability[]
  calendarBlocks SupplierCalendarBlock[]

  @@index([supplierId])
  @@index([destinationId])
  @@index([status, featured])
  @@index([createdAt])
  @@map("tours")
}

// ─────────────────────────────────────────────────────────────────────────────
// 5. TRANSPORTATION SERVICES
// ─────────────────────────────────────────────────────────────────────────────

model TransportationService {
  id            String        @id @default(cuid())
  supplierId    String
  destinationId String?
  title         String
  type        TransportType
  description String?       @db.Text
  capacity    Int
  price       Decimal       @db.Decimal(12, 2)
  currency    String        @default("FJD")
  image       String?
  status      ServiceStatus @default(PENDING)
  featured    Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  supplier Supplier  @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  destination Destination? @relation(fields: [destinationId], references: [id], onDelete: SetNull)
  bookings Booking[]

  @@index([supplierId, status])
  @@index([type, featured])
  @@index([destinationId])
  @@map("transportation_services")
}

// ─────────────────────────────────────────────────────────────────────────────
// 6. BOOKINGS
// ─────────────────────────────────────────────────────────────────────────────

model Booking {
  id               String        @id @default(cuid())
  bookingNumber    String        @unique
  travelerId       String
  supplierId       String
  tourId           String?
  transportId      String?
  amount           Decimal       @db.Decimal(12, 2)
  commissionAmount Decimal       @db.Decimal(12, 2)
  supplierAmount   Decimal       @db.Decimal(12, 2)
  currency         String        @default("FJD")
  paymentStatus    PaymentStatus @default(PENDING)
  bookingStatus    BookingStatus @default(PENDING)
  paymentMode      PaymentMode   @default(FULL)
  adultCount       Int           @default(1)
  childCount       Int           @default(0)
  subtotal         Decimal       @db.Decimal(12, 2) @default(0)
  taxAmount        Decimal       @db.Decimal(12, 2) @default(0)
  serviceFee       Decimal       @db.Decimal(12, 2) @default(0)
  discountAmount   Decimal       @db.Decimal(12, 2) @default(0)
  walletCredit     Decimal       @db.Decimal(12, 2) @default(0)
  depositAmount    Decimal?      @db.Decimal(12, 2)
  promoCode        String?
  timeSlot         String?
  pickupLocation   String?
  checkoutSessionId String?      @unique
  bookingDate      DateTime      @default(now())
  travelDate       DateTime?
  guestCount       Int           @default(1)
  notes            String?       @db.Text
  cancelledAt      DateTime?
  cancelReason     String?
  refundedAt       DateTime?
  refundAmount     Decimal?      @db.Decimal(12, 2)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  traveler  User                   @relation("TravelerBookings", fields: [travelerId], references: [id], onDelete: Restrict)
  supplier  Supplier               @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  tour      Tour?                  @relation(fields: [tourId], references: [id], onDelete: SetNull)
  transport TransportationService? @relation(fields: [transportId], references: [id], onDelete: SetNull)
  payments  Payment[]
  timelineEvents BookingEvent[]
  invoices  TravellerInvoice[]
  refunds   TravellerRefund[]
  items     BookingItem[]
  travellers BookingTraveller[]
  voucher   BookingVoucher?
  bookingInvoice BookingInvoice?
  paymentAttempts PaymentAttempt[]
  transactions Transaction[]
  logs      BookingLog[]
  checkoutSession CheckoutSession? @relation(fields: [checkoutSessionId], references: [id], onDelete: SetNull)

  @@index([travelerId])
  @@index([supplierId])
  @@index([tourId])
  @@index([transportId])
  @@index([bookingStatus, paymentStatus])
  @@index([bookingDate])
  @@index([travelDate])
  @@map("bookings")
}

// ─────────────────────────────────────────────────────────────────────────────
// 7. PAYMENTS
// ─────────────────────────────────────────────────────────────────────────────

model Payment {
  id              String              @id @default(cuid())
  bookingId       String
  stripePaymentId String?             @unique
  stripeIntentId  String?             @unique
  amount          Decimal             @db.Decimal(12, 2)
  currency        String              @default("FJD")
  status          StripePaymentStatus @default(REQUIRES_PAYMENT_METHOD)
  failureMessage  String?
  refundedAmount  Decimal?            @db.Decimal(12, 2)
  metadata        Json?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  attempts PaymentAttempt[]

  @@index([bookingId])
  @@index([status])
  @@index([createdAt])
  @@map("payments")
}

// ─────────────────────────────────────────────────────────────────────────────
// 8. SETTLEMENTS
// ─────────────────────────────────────────────────────────────────────────────

model Settlement {
  id            String           @id @default(cuid())
  supplierId    String
  amount        Decimal          @db.Decimal(12, 2)
  grossAmount   Decimal          @db.Decimal(12, 2)
  commission    Decimal          @db.Decimal(12, 2)
  currency      String           @default("FJD")
  invoiceNumber String           @unique
  periodStart   DateTime
  periodEnd     DateTime
  status        SettlementStatus @default(PENDING)
  paidAt        DateTime?
  invoiceUrl    String?
  notes         String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  @@index([supplierId, status])
  @@index([periodStart, periodEnd])
  @@map("settlements")
}

// ─────────────────────────────────────────────────────────────────────────────
// 9. REVIEWS
// ─────────────────────────────────────────────────────────────────────────────

model Review {
  id        String       @id @default(cuid())
  userId    String
  tourId    String
  rating    Int
  review    String?      @db.Text
  status    ReviewStatus @default(PENDING)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  tour Tour @relation(fields: [tourId], references: [id], onDelete: Cascade)
  media ReviewMedia[]

  @@unique([userId, tourId])
  @@index([tourId, status])
  @@index([rating])
  @@map("reviews")
}

// ─────────────────────────────────────────────────────────────────────────────
// 10. TRAVEL GUIDES
// ─────────────────────────────────────────────────────────────────────────────

model TravelGuide {
  id            String        @id @default(cuid())
  title         String
  slug          String        @unique
  content       String        @db.Text
  body          Json?
  excerpt       String?
  featuredImage String?
  category      GuideCategory @default(GENERAL)
  featured      Boolean       @default(false)
  status        ContentStatus @default(DRAFT)
  authorId      String?
  publishedAt   DateTime?
  sortOrder     Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([category, status])
  @@index([featured, status])
  @@index([publishedAt])
  @@map("travel_guides")
}

// ─────────────────────────────────────────────────────────────────────────────
// 11. FAQS
// ─────────────────────────────────────────────────────────────────────────────

model Faq {
  id        String        @id @default(cuid())
  question  String
  answer    String        @db.Text
  category  String?
  sortOrder Int           @default(0)
  published Boolean       @default(true)
  status    ContentStatus @default(PUBLISHED)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([published, sortOrder])
  @@index([status])
  @@map("faqs")
}

// ─────────────────────────────────────────────────────────────────────────────
// 12. NOTIFICATIONS
// ─────────────────────────────────────────────────────────────────────────────

model Notification {
  id        String           @id @default(cuid())
  userId    String
  title     String
  message   String           @db.Text
  type      NotificationType
  isRead    Boolean          @default(false)
  metadata  Json?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

// ─────────────────────────────────────────────────────────────────────────────
// 13. ACTIVITY LOGS
// ─────────────────────────────────────────────────────────────────────────────

model ActivityLog {
  id        String         @id @default(cuid())
  userId    String?
  action    String
  module    ActivityModule
  entityId  String?
  metadata  Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime       @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([module, createdAt])
  @@index([entityId])
  @@map("activity_logs")
}

// ─────────────────────────────────────────────────────────────────────────────
// PLATFORM CONFIGURATION
// ─────────────────────────────────────────────────────────────────────────────

model PlatformSettings {
  id                    String   @id @default("default")
  platformName          String   @default("My Fiji Tour")
  supportEmail          String   @default("concierge@myfijitour.com")
  defaultCurrency       String   @default("FJD")
  timezone              String   @default("Pacific/Fiji")
  commissionPercentage  Decimal  @default(15) @db.Decimal(5, 2)
  stripeMode            String   @default("test")
  emailFromName         String?
  emailFromAddress      String?
  googleAnalyticsId     String?
  microsoftClarityId    String?
  searchConsoleProperty String?
  updatedAt             DateTime @updatedAt

  @@map("platform_settings")
}

model CommissionRule {
  id               String   @id @default(cuid())
  name             String
  percentage       Decimal  @db.Decimal(5, 2)
  minBookingAmount Decimal? @db.Decimal(12, 2)
  maxBookingAmount Decimal? @db.Decimal(12, 2)
  supplierId       String?
  tourCategory     String?
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  supplier Supplier? @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([active])
  @@index([supplierId])
  @@map("commission_rules")
}

// ─────────────────────────────────────────────────────────────────────────────
// CONTENT MANAGEMENT
// ─────────────────────────────────────────────────────────────────────────────

model Banner {
  id        String        @id @default(cuid())
  title     String
  subtitle  String?
  imageUrl  String
  linkUrl   String?
  position  String        @default("homepage")
  status    ContentStatus @default(DRAFT)
  sortOrder Int           @default(0)
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([position, status])
  @@map("banners")
}

model HomepageSection {
  id        String        @id @default(cuid())
  key       String        @unique
  title     String
  content   Json
  status    ContentStatus @default(DRAFT)
  sortOrder Int           @default(0)
  updatedAt DateTime      @updatedAt

  @@map("homepage_sections")
}

/// Hotels & resorts — Places to Stay module
model Accommodation {
  id             String        @id @default(cuid())
  title          String
  slug           String        @unique
  location       String
  destinationId  String?
  stars          Int           @default(5)
  priceFrom      String?
  overview       String        @db.Text
  heroImage      String?
  gallery        String[]      @default([])
  amenities      String[]      @default([])
  experiences    String[]      @default([])
  content        Json?
  collection     String?
  relatedSlugs   String[]      @default([])
  featured       Boolean       @default(false)
  status         ContentStatus @default(DRAFT)
  sortOrder      Int           @default(0)
  updatedById    String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  destination Destination? @relation(fields: [destinationId], references: [id], onDelete: SetNull)

  @@index([status, featured, sortOrder])
  @@index([destinationId])
  @@map("accommodations")
}

/// Deals & offers — packages, accommodation and experience promotions
model Deal {
  id                 String        @id @default(cuid())
  title              String
  slug               String        @unique
  description        String        @db.Text
  location           String
  destinationId      String?
  price              String
  priceNote          String?
  image              String?
  category           DealCategory  @default(PACKAGE)
  includes           String[]      @default([])
  featured           Boolean       @default(false)
  content            Json?
  /// Package commercial fields — queryable without parsing JSON
  packageDestination String?
  resortName         String?
  duration           String?
  travelDates        String?
  bookBeforeDate     String?
  bonusValue         String?
  resortCredit       String?
  includedFlights    Boolean       @default(false)
  includedTransfers  Boolean       @default(false)
  includedMeals      String?
  includedActivities String[]      @default([])
  packageTags        String[]      @default([])
  status             ContentStatus @default(DRAFT)
  sortOrder          Int           @default(0)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  destination Destination? @relation(fields: [destinationId], references: [id], onDelete: SetNull)

  @@index([status, featured, category])
  @@index([destinationId])
  @@map("deals")
}

/// Site navigation — primary nav, mega menu items and footer links
model NavigationItem {
  id          String             @id @default(cuid())
  label       String
  href        String
  description String?
  location    NavigationLocation @default(PRIMARY)
  parentKey   String?
  icon        String?
  image       String?
  featured    Boolean            @default(false)
  status      ContentStatus      @default(PUBLISHED)
  sortOrder   Int                @default(0)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([location, parentKey, sortOrder])
  @@map("navigation_items")
}

// ─────────────────────────────────────────────────────────────────────────────
// SUPPORT CENTER
// ─────────────────────────────────────────────────────────────────────────────

model SupportTicket {
  id           String         @id @default(cuid())
  userId       String
  supplierId   String?
  assignedToId String?
  type         TicketType
  subject      String
  message      String         @db.Text
  status       TicketStatus   @default(OPEN)
  priority     TicketPriority @default(MEDIUM)
  resolvedAt   DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  user       User      @relation("TicketSubmitter", fields: [userId], references: [id], onDelete: Restrict)
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  assignedTo User?     @relation("TicketAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([status, priority])
  @@index([userId])
  @@index([supplierId])
  @@map("support_tickets")
}

// ─────────────────────────────────────────────────────────────────────────────
// ANALYTICS INTEGRATIONS
// ─────────────────────────────────────────────────────────────────────────────

model AnalyticsSnapshot {
  id             String          @id @default(cuid())
  date           DateTime        @db.Date
  visitors       Int             @default(0)
  pageViews      Int             @default(0)
  sessions       Int             @default(0)
  conversionRate Decimal         @default(0) @db.Decimal(5, 2)
